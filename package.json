{
  "name": "hetvaya-flowgrid",
  "version": "2.0.0",
  "description": "AI-Powered FMCG Distribution Intelligence, Expiry-Aware Inventory Optimization, and Constrained Dispatch",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i src/css/input.css -o src/css/flowgrid.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "start": "python run.py",
    "test": "pytest -v"
  },
  "keywords": [
    "fmcg",
    "supply-chain",
    "inventory-optimization",
    "or-tools",
    "fastapi",
    "vite"
  ],
  "author": "HETVAYA Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
