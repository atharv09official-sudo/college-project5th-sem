#############################################
# CORE APPLICATION SETTINGS
#############################################

APP_NAME=Smart_Supply_Chain_Risk_System
APP_ENV=production
APP_VERSION=1.0.0
TIMEZONE=Asia/Kolkata


#############################################
# WEB SEARCH & OPEN INTELLIGENCE
#############################################

# SERP API — Web search, blogs, fuel news, sanctions, regional updates
SERP_API_KEY=6a75d63e6b65a8e080b9f01dea83b619fae558a30ae83ce347e2056fb39aac73


#############################################
# NEWS & GLOBAL EVENTS
#############################################

# NewsData API — structured global & local news
NEWSDATA_API_KEY=your_newsdata_api_key_here

# GNews API — regional & country-level news
GNEWS_API_KEY=your_gnews_api_key_here


#############################################
# AI REASONING & SUMMARIZATION (OpenRouter)
#############################################

# OpenRouter unified AI gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Preferred free-tier models
OPENROUTER_MODEL_SUMMARY=deepseek/r1t2-chimera:free
OPENROUTER_MODEL_REASONING=devstral/2-2512:free
OPENROUTER_MODEL_FAST=mimo/v2-flash:free


#############################################
# WEATHER & NATURAL DISRUPTIONS
#############################################

# OpenWeatherMap — storms, floods, extreme conditions
OPENWEATHER_API_KEY=your_openweather_api_key_here


#############################################
# FUEL & ENERGY PRICE SIGNALS
#############################################

# Fuel data derived mainly via SERP + open datasets
FUEL_DATA_SOURCE=SERP_AND_OPEN_DATA
FUEL_PRICE_CURRENCY=INR


#############################################
# RISK SCORING CONFIGURATION
#############################################

RISK_SCORE_MIN=0
RISK_SCORE_MAX=10

RISK_THRESHOLD_HIGH=4
RISK_THRESHOLD_MEDIUM=7
RISK_THRESHOLD_LOW=8


#############################################
# COMPLIANCE & SANCTIONS MONITORING
#############################################

SANCTION_MONITORING_ENABLED=true
MANUAL_REVIEW_REQUIRED_FOR_LOW_SCORE=true


#############################################
# RATE LIMITING & SAFETY
#############################################

MAX_EXTERNAL_REQUESTS_PER_MIN=60
MAX_AI_REQUESTS_PER_MIN=30


#############################################
# LOGGING & AUDIT
#############################################

ENABLE_AUDIT_LOGS=true
LOG_LEVEL=INFO
STORE_EVIDENCE_SNAPSHOTS=true


#############################################
# SECURITY (TRADITIONAL BEST PRACTICE)
#############################################

ALLOW_FRONTEND_API_ACCESS=false
ROTATE_KEYS_INTERVAL_DAYS=90

